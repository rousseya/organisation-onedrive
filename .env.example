# PDF Organization Paths
PDF_SOURCE_PATH=/path/to/your/pdf/source
PDF_OUTPUT_PATH=/path/to/your/pdf/output

# File Organization Options
CREATE_FOLDERS=True       # Create category folders if they don't exist
MOVE_FILES=False          # False=copy, True=move files
RENAME_FILES=True         # Rename files to ASCII-compatible names (max 30 chars)

# Configuration
CONFIG_FILE=config/categories.json

# Documentation Language
DOC_LANGUAGE=en           # Language for generated markdown files: 'en' or 'fr'

# AI Vision Analysis (Mistral)
AI_API_KEY=your-mistral-api-key-here
USE_AI_ANALYSIS=True      # Enable Mistral Vision for scanned PDFs

# Database Caching (SQLite)
# Database will be created automatically at: {PDF_OUTPUT_PATH}/pdfs_inventory.db
# This enables:
# - Caching: Skip reprocessing PDFs already organized
# - Deduplication: Detect exact (MD5) and similar (Perceptual Hash) documents
# - Tracking: Store source paths and metadata for auditing
